{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@smith/tsconfig/react",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true
  }
}

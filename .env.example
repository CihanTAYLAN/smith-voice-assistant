# Smith ortam yapilandirmasi ornegi.
# Kopyala: cp .env.example .env    —  .env asla commit edilmez.
# Semanin tek kaynagi: packages/env/src/index.ts

# --- genel ---
NODE_ENV=development
LOG_LEVEL=info
# Smith baglamina alinmayacak sourceId globlari ve `kw:` anahtar kelimeleri.
SMITH_CONTEXT_EXCLUDE=obsidian:acme/*,code:_workshop-smoke/*,kw:acme

# --- gateway ---
PORT=4100
# En az 32 karakter. Uretimde rastgele uret: openssl rand -base64 48
SESSION_SECRET=degistir-bu-degeri-en-az-32-karakter-olmali
# Virgulle ayrilmis izinli origin listesi
CORS_ORIGINS=http://localhost:3000
# Faz 2b: sohbet turunu core tool-loop'una gecir (model hafiza araclarini
# cagirabilir). Bos veya 0 = KAPALI (mevcut streaming yol). Acmak icin: 1
SMITH_AGENT_LOOP=
# Guvenlik bayraklari: yalniz gateway okur (sema disi, apps/gateway/src/env-flags.ts).
# '1' | 'true' | 'on' acik; bos ve diger her deger kapali sayilir.
# Kimliksiz /v1/auth/register ucunu acar. Bos = KAPALI (hesaplar seed betigiyle acilir).
SMITH_ALLOW_REGISTRATION=
# WebSocket ?token= kimlik yolunu kapatir. Bos = ACIK (JWT URL'ye duser); istemci /v1/ws/ticket kullanmali.
SMITH_WS_DISABLE_LEGACY_TOKEN=

# --- veri ---
# pgvector eklentisi zorunlu.
# DIKKAT: portlar docker/dev-compose.yml ile ayni olmali — 5433 ve 6380.
# Standart 5432/6379 bu makinede BASKA projelere ait; oraya baglanma.
DATABASE_URL=postgresql://smith:smith@127.0.0.1:5433/smith
REDIS_URL=redis://127.0.0.1:6380

# --- modeller ---
# Bulut tarafi (opsiyonel; yoksa yalniz yerel model kullanilir)
ANTHROPIC_API_KEY=
# Yerel model yolu — token maliyeti sifir olan taraf
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- sohbet modeli (OpenAI-uyumlu uc) ---
# Ucunu bos birakirsan sohbet YEREL Ollama'da kosar ve hicbir veri makineden
# cikmaz. Embedding bunun degil asagidaki SMITH_EMBED_* ucunun isidir
# (varsayilan yerel, uzak uc verilebilir); "her durumda yerel" DEGILDIR.
#
# Uzak bir uc verirsen (Gemini/OpenRouter — hepsi OpenAI-uyumlu),
# ANAHTAR ve MODEL de zorunlu olur; eksikse surec acilista durur:
#   SMITH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   SMITH_LLM_API_KEY=...        (gercek anahtar .env'e degil, bkz. asagi)
#   SMITH_LLM_MODEL=gemini-3.5-flash
#
# Gercek anahtarlar icin scripts/dev-secrets.local.ps1 kullan (.gitignore'da).
SMITH_LLM_BASE_URL=
SMITH_LLM_API_KEY=
# Yerel varsayilan. Uzak uc secilirse bu ad gecersizdir ve degistirilmelidir.
SMITH_LLM_MODEL=gemma3:1b

# --- yedek saglayici zinciri (opsiyonel mekanizma; bu kurulumda BAGLI DEGIL) ---
# Birincil GECICI olarak dusunce (429 kota / 503 yuk / stall) istek siradaki
# halkaya duser. Kalici hatalarda (400/401/403) yedege DUSULMEZ, hemen patlar —
# yoksa kendi bug'imizi "saglayici bozuk" diye maskeleriz.
# NOT (2026-09-18): Yedek saglayici baglanmayacak — Mistral terk edildi; asagidaki
# uc alan bos kalir. Mekanizma jeneriktir: OpenAI-uyumlu herhangi bir uc
# verilebilir; model ADI saglayiciya ozgudur (birinin adi digerinde gecmez).
# Gercek anahtar .env'e DEGIL scripts/dev-secrets.local.ps1'e.
SMITH_LLM_FALLBACK_BASE_URL=
SMITH_LLM_FALLBACK_API_KEY=
SMITH_LLM_FALLBACK_MODEL=
# Zincirin SON halkasi yerel Ollama olsun mu (varsayilan KAPALI). Kucuk yerel
# model tool-calling'i guvenilir yapamaz; acikken bulut dustugunde asistan
# "calisiyor" gorunup sessizce yanlis is yapar. Yalniz duz sohbet icin acilir.
SMITH_LLM_LOCAL_FALLBACK=
SMITH_LLM_LOCAL_MODEL=gemma3:1b
# Tek denemenin ust suresi (ms, varsayilan 45000). STALL'i yakalayan sey budur.
SMITH_LLM_TIMEOUT_MS=

# --- embedding ucu (gateway VE worker ayni okur; createEmbedderFromEnv) ---
# Bos = yerel Ollama/nomic (hafiza icerigi makineden cikmaz). Uzak uc verilirse
# (or. gemini-embedding-001 @ 768) o kullanilir; ANAHTAR .env'e degil
# dev-secrets.local.ps1'e. Boyut daima 768 (DB vector kolonu).
SMITH_EMBED_BASE_URL=
SMITH_EMBED_API_KEY=
SMITH_EMBED_MODEL=nomic-embed-text
SMITH_EMBED_DIMENSIONS=

# --- periyodik hafiza bakimi ---
# 0: takvim ve tuketici kapali. Varsayilan: her gun yerel 03:30.
SMITH_MEMORY_MAINTENANCE=1
# Bos: gunluk cron. Dolu: milisaniye aralik (en az 60000).
SMITH_MEMORY_MAINTENANCE_INTERVAL_MS=
# Bos: worker isletim sisteminin saat dilimi. Konteyner icin acikca belirt.
SMITH_MEMORY_MAINTENANCE_TIMEZONE=
SMITH_MEMORY_MAINTENANCE_SIMILARITY=0.92
SMITH_MEMORY_MAINTENANCE_MAX_CLUSTERS=10
SMITH_MEMORY_MAINTENANCE_MAX_GAPS=10

# --- gozlemlenebilirlik (opsiyonel) ---
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Smith gateway — production imaji (Dokploy).
# Calistirir: Hono HTTP + WS, tek giris kapisi (:4100).
# Migration: entrypoint once `prisma migrate deploy` kosar, sonra node baslar.
FROM node:22-bookworm-slim AS build
# git: kokteki `prepare` script'i (lefthook install) build sirasinda da kosar.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY tooling ./tooling
COPY packages ./packages
COPY apps/gateway ./apps/gateway
# --ignore-scripts: kokteki `prepare` (lefthook install) git reposu ister,
# build context'te .git yok. Gerekli tek uretim adimi prisma generate, o da
# asagida acikca calisiyor. Runtime'da derleme gerektiren bagimlilik yok.
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @smith/db exec prisma generate
RUN pnpm --filter @smith/gateway build

FROM node:22-bookworm-slim AS runtime
# pnpm RUNTIME'DA da gerekli: migration `pnpm --filter @smith/db exec prisma
# migrate deploy` ile kosuyor ve pnpm, paketin kendi .bin shim'ini cozumleyen
# tek yol. Elle bir yol yazmak kirilgan (pnpm ./.pnpm/<paket>@<hash>/
# node_modules/.bin/...). Saha kaniti: ilk denemede corepack runtime'da
# olmadigi icin "sh: 1: pnpm: not found" ve gateway migration hic kacamadi.
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
# openssl: Prisma CLI her `migrate deploy` calisisinda libssl surumunu arar;
# bulamazsa "may not work as expected" uyarisi basar ve openssl-1.1.x'e duser.
# Runtime sorgulari saf JS surucu (@prisma/adapter-pg -> pg) kullandigi icin
# teknik gereksinim DEGIL; ama prod'da her boot'ta cikan bu uyari gercek
# bir hatayi taklit ediyor ve okuyanı yaniltiyor. 1 MB, gider.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
# Gateway varsayilan olarak loopback'te dinler; konteyner icinde disaridan (web
# servisi, port yayini) erisilebilmesi icin tum arayuzler burada ACIKCA verilir.
# compose.prod.yml de ayni degeri verir; hangisi eski kalirsa digeri prod'u korur.
ENV SMITH_GATEWAY_HOST=0.0.0.0
# Derlenmis agaci oldugu gibi al (workspace symlink'leri + dist'ler korunur).
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/.npmrc ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/tooling ./tooling
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/gateway ./apps/gateway
COPY docker/prod/entrypoint-gateway.sh ./docker/prod/entrypoint-gateway.sh
COPY docker/prod/provision.mjs ./docker/prod/provision.mjs
RUN chmod +x ./docker/prod/entrypoint-gateway.sh
EXPOSE 4100
ENTRYPOINT ["./docker/prod/entrypoint-gateway.sh"]
